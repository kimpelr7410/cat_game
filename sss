
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>AI GLASSES: EMP EXAM</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#10141a;color:white;font-family:Arial,sans-serif;overflow:hidden;touch-action:manipulation}
#game{width:100vw;height:100dvh;position:relative;overflow:hidden}
canvas{width:100%;height:100%;display:block}
#hud{position:absolute;top:0;left:0;width:100%;padding:13px;pointer-events:none;text-shadow:0 2px 5px black}
.row{display:flex;justify-content:space-between;gap:10px}
.stat{font-size:13px;font-weight:bold}
.bar{height:10px;background:#303943;border-radius:10px;overflow:hidden;margin-top:5px}
.fill{height:100%;width:0%;transition:width .1s}
#answerFill{background:#36ef9b}
#susFill{background:#ff5555}
#chargeFill{background:#f7a32d}
#glass{position:absolute;inset:0;display:none;pointer-events:none;background:radial-gradient(ellipse,transparent 35%,rgba(0,255,140,.08))}
#glass.active{display:block}
#code{position:absolute;top:22%;left:50%;transform:translateX(-50%);width:min(82%,500px);color:#64ffae;font:12px monospace;background:rgba(0,15,10,.75);border:1px solid #48ff9a;border-radius:8px;padding:14px;box-shadow:0 0 22px #00ff8866;text-shadow:0 0 7px #00ff88}
#code .big{font-size:19px;font-weight:bold;margin:8px 0}
#warning{position:absolute;top:51%;left:50%;transform:translate(-50%,-50%);color:#ff5555;font-size:15px;font-weight:bold;text-shadow:0 0 10px red;text-align:center;pointer-events:none}
#controls{position:absolute;bottom:20px;left:0;width:100%;display:flex;justify-content:center;padding:12px}
button{border:0;border-radius:12px;padding:16px 22px;font-size:16px;font-weight:bold;cursor:pointer}
#toggle{background:#168d58;color:white;min-width:190px}
#toggle.on{background:#c43d3d}
#message{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#111e;padding:25px;border:1px solid #888;border-radius:15px;text-align:center;width:min(88%,400px);z-index:10}
#message h1{font-size:24px}
#message p{line-height:1.6;color:#ccc;font-size:14px}
#start,#restart{background:#eee;color:#111}
.hidden{display:none!important}
#timer{font-size:18px;color:#fff}
.danger{color:#ff4444!important;animation:blink .5s infinite}
@keyframes blink{50%{opacity:.3}}
</style>
</head>
<body>
<div id="game">
<canvas id="scene"></canvas>

<div id="hud">
 <div class="row">
  <div class="stat">QUESTION <span id="q">1</span> / 45</div>
  <div class="stat">TIME <span id="clock">03:00</span></div>
 </div>
 <div class="stat" style="margin-top:12px">ANSWER DATA <span id="ans">0</span>%</div>
 <div class="bar"><div id="answerFill" class="fill"></div></div>
 <div class="stat" style="margin-top:10px">SUSPICION <span id="sus">0</span>%</div>
 <div class="bar"><div id="susFill" class="fill"></div></div>
 <div class="stat" style="margin-top:10px">EMP CHARGING <span id="chargeText">0</span>%</div>
 <div class="bar"><div id="chargeFill" class="fill"></div></div>
</div>

<div id="glass">
 <div id="code">
  <div>AI GLASSES // CONNECTED</div>
  <div class="big">ANSWER ANALYSIS</div>
  <div>
   &gt; OPTICAL RECOGNITION ACTIVE<br>
   &gt; FETCHING ANSWER DATABASE...<br>
   &gt; ENCRYPTED DATA RECEIVED
  </div>
  <div class="big" id="fakeAnswer">ANSWER: B</div>
  <div>DATA TRANSFER: <span id="transfer">0</span>%</div>
  <div style="margin-top:8px">SIGNAL: STABLE</div>
 </div>
</div>

<div id="warning"></div>

<div id="controls">
 <button id="toggle" disabled>◉ AI 안경 작동</button>
</div>

<div id="message">
 <h1>AI GLASSES</h1>
 <p>
  시험장에 설치된 EMP 광선총을 조심하라.<br>
  감독관은 의심도가 높아질수록 당신을 응시하고<br>
  EMP 광선총을 충전한다.<br><br>
  3분 안에 45문제를 해결하라.<br>
  안경이 파괴되면 게임 오버.
 </p>
 <button id="start">시험 시작</button>
</div>
</div>

<script>
(()=>{
'use strict';

const canvas=document.getElementById('scene');
const ctx=canvas.getContext('2d');
const $=id=>document.getElementById(id);

let W=0,H=0;
let playing=false,active=false,ended=false;
let question=0,answer=0,suspicion=0;
let timeLeft=180;
let looking=false,empCharge=0;
let fired=false,explosion=0;
let last=0;

function resize(){
 const dpr=Math.min(devicePixelRatio||1,2);
 W=canvas.clientWidth;H=canvas.clientHeight;
 canvas.width=W*dpr;canvas.height=H*dpr;
 ctx.setTransform(dpr,0,0,dpr,0,0);
}
window.addEventListener('resize',resize);
resize();

function rect(x,y,w,h,c){
 ctx.fillStyle=c;ctx.fillRect(x,y,w,h);
}
function line(x,y,x2,y2,c,width=1){
 ctx.strokeStyle=c;ctx.lineWidth=width;
 ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x2,y2);ctx.stroke();
}
function polygon(points,c){
 ctx.fillStyle=c;ctx.beginPath();
 ctx.moveTo(...points[0]);
 points.slice(1).forEach(p=>ctx.lineTo(...p));
 ctx.closePath();ctx.fill();
}

function classroom(){
 const horizon=H*.43;

 // ceiling
 rect(0,0,W,H,'#655c50');
 polygon([[0,0],[W,0],[W*.86,horizon],[W*.14,horizon]],'#c4c1b6');

 // back wall
 rect(0,horizon,W,H*.35,'#b5ad9d');

 // floor
 polygon([[0,H*.78],[W,H*.78],[W,H],[0,H]],'#655c50');

 for(let i=0;i<9;i++){
  line(W*i/8,H*.78,W*.5+(W*i/8-W*.5)*2,H,'#857767');
 }
 for(let i=0;i<5;i++){
  line(0,H*.8+i*i*H*.008,W,H*.8+i*i*H*.008,'#827565');
 }

 // blackboard
 rect(W*.24,horizon*.36,W*.52,H*.20,'#263b38');
 rect(W*.23,horizon*.33,W*.54,H*.025,'#796448');
 rect(W*.23,horizon*.57,W*.54,H*.02,'#796448');
 ctx.fillStyle='#c8d5bd';
 ctx.font=`${Math.max(10,W*.017)}px monospace`;
 ctx.fillText('FINAL EXAMINATION',W*.36,horizon*.49);

 // windows
 for(let i=0;i<3;i++){
  let x=W*(.025+i*.115);
  rect(x,horizon*.3,W*.085,H*.19,'#8bb3c0');
  rect(x+W*.04,horizon*.3,W*.004,H*.19,'#e3e0d5');
 }

 // door
 rect(W*.86,horizon*.35,W*.11,H*.3,'#59483b');

 // teacher's desk
 rect(W*.38,H*.70,W*.25,H*.035,'#584333');
 polygon([[W*.4,H*.735],[W*.61,H*.735],[W*.59,H*.82],[W*.42,H*.82]],'#493a30');

 // student desks
 for(let i=0;i<3;i++){
  let x=W*(.04+i*.34),y=H*.87;
  rect(x,y,W*.23,H*.025,'#78583d');
  polygon([[x+W*.01,y+H*.025],[x+W*.22,y+H*.025],[x+W*.20,y+H*.10],[x+W*.03,y+H*.10]],'#513d2d');
  rect(x+W*.025,y+H*.10,W*.014,H*.07,'#342a24');
  rect(x+W*.19,y+H*.10,W*.014,H*.07,'#342a24');
 }
}

function examiner(){
 const x=W*.5,y=H*.53;
 const head=H*.075,bw=W*.055,body=H*.19;

 // shadow
 ctx.fillStyle='#0004';
 ctx.beginPath();ctx.ellipse(x,y+body*.9,bw*1.5,10,0,0,Math.PI*2);ctx.fill();

 // legs
 rect(x-bw*.65,y+body*.55,bw*.45,body*.5,'#292d35');
 rect(x+bw*.2,y+body*.55,bw*.45,body*.5,'#292d35');

 // body
 rect(x-bw,y,bw*2,body*.7,'#354d65');
 polygon([[x-bw*.5,y],[x,y+body*.2],[x+bw*.5,y],[x+bw*.2,y+body*.65],[x-bw*.2,y+body*.65]],'#d8d8cf');
 polygon([[x-bw*.13,y+body*.05],[x+bw*.13,y+body*.05],[x+bw*.1,y+body*.48],[x,y+body*.57],[x-bw*.1,y+body*.48]],'#9e3434');

 // head
 ctx.fillStyle='#d5a985';
 ctx.beginPath();ctx.arc(x,y-head*.25,head*.65,0,Math.PI*2);ctx.fill();

 // hair
 ctx.fillStyle='#29211d';
 ctx.beginPath();ctx.arc(x,y-head*.45,head*.65,Math.PI,Math.PI*2);ctx.fill();
 rect(x-head*.65,y-head*.48,head*1.3,head*.18,'#29211d');

 // eyes: turn toward player
 ctx.fillStyle='#29221d';
 const eyeOffset=looking?0:head*.2;
 ctx.beginPath();ctx.arc(x-head*.22+eyeOffset,y-head*.23,head*.065,0,Math.PI*2);ctx.fill();
 ctx.beginPath();ctx.arc(x+head*.22+eyeOffset,y-head*.23,head*.065,0,Math.PI*2);ctx.fill();

 // EMP gun
 if(suspicion>=45){
  const gunX=x+bw*1.05,gunY=y+body*.27;
  rect(gunX,gunY,bw*.9,bw*.35,'#20232c');
  rect(gunX+bw*.65,gunY-bw*.12,bw*.4,bw*.12,'#777b85');
  rect(gunX+bw*.1,gunY+bw*.25,bw*.2,bw*.35,'#29232c');

  ctx.fillStyle='#ff9b22';
  ctx.shadowColor='#ff7b00';
  ctx.shadowBlur=empCharge/2;
  ctx.beginPath();
  ctx.arc(gunX+bw*.95,gunY+bw*.17,bw*(.12+empCharge/500),0,Math.PI*2);
  ctx.fill();
  ctx.shadowBlur=0;
 }
}

function drawEMP(){
 if(empCharge<=0)return;
 const x=W*.5+W*.065;
 const y=H*.53+H*.05;
 const intensity=empCharge/100;

 if(empCharge>20){
  ctx.save();
  ctx.globalAlpha=.2+intensity*.45;
  ctx.strokeStyle='#ff9d25';
  ctx.lineWidth=2+intensity*4;
  ctx.shadowColor='#ff6b00';
  ctx.shadowBlur=15+intensity*30;
  ctx.beginPath();
  ctx.moveTo(x,y);
  ctx.lineTo(W*.5,H*.7);
  ctx.stroke();
  ctx.restore();
 }
 if(empCharge>70){
  ctx.fillStyle='#ff9d25';
  ctx.font='bold 14px Arial';
  ctx.textAlign='center';
  ctx.fillText('EMP CHARGING',W*.5,H*.38);
 }
}

function drawExplosion(){
 if(!fired)return;
 const alpha=Math.max(0,explosion/1.1);
 ctx.save();
 ctx.globalAlpha=alpha;
 const g=ctx.createRadialGradient(W*.5,H*.5,5,W*.5,H*.5,H*.75);
 g.addColorStop(0,'#ffffff');
 g.addColorStop(.2,'#a9ffff');
 g.addColorStop(.55,'#398dff');
 g.addColorStop(1,'transparent');
 ctx.fillStyle=g;ctx.fillRect(0,0,W,H);

 ctx.strokeStyle='#baffff';
 ctx.lineWidth=5;
 for(let i=0;i<8;i++){
  const a=i*Math.PI/4;
  ctx.beginPath();
  ctx.moveTo(W*.5,H*.5);
  ctx.lineTo(W*.5+Math.cos(a)*W*.8,H*.5+Math.sin(a)*H*.8);
  ctx.stroke();
 }
 ctx.restore();
}

function draw(){
 ctx.clearRect(0,0,W,H);
 classroom();
 examiner();
 drawEMP();

 // first person hands
 rect(W*.31,H*.96,W*.09,H*.04,'#c19a7c');
 rect(W*.60,H*.96,W*.09,H*.04,'#c19a7c');

 if(active){
  ctx.strokeStyle='#4affaa';ctx.lineWidth=1;
  ctx.beginPath();ctx.arc(W/2,H*.58,13,0,Math.PI*2);ctx.stroke();
  line(W/2-23,H*.58,W/2-9,H*.58,'#4affaa');
  line(W/2+9,H*.58,W/2+23,H*.58,'#4affaa');
  line(W/2,H*.58-23,W/2,H*.58-9,'#4affaa');
  line(W/2,H*.58+9,W/2,H*.58+23,'#4affaa');
 }

 if(playing){
  const g=ctx.createRadialGradient(W/2,H/2,H*.2,W/2,H/2,H*.8);
  g.addColorStop(0,'transparent');
  g.addColorStop(1,'rgba(0,0,0,.35)');
  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
 }
 if(fired)drawExplosion();
}

function updateHUD(){
 $('q').textContent=Math.min(question+1,45);
 $('ans').textContent=Math.floor(answer);
 $('sus').textContent=Math.floor(suspicion);
 $('answerFill').style.width=answer+'%';
 $('susFill').style.width=suspicion+'%';
 $('chargeText').textContent=Math.floor(empCharge);
 $('chargeFill').style.width=empCharge+'%';

 const mins=Math.floor(timeLeft/60);
 const secs=Math.floor(timeLeft%60);
 $('clock').textContent=String(mins).padStart(2,'0')+':'+String(secs).padStart(2,'0');
 $('clock').classList.toggle('danger',timeLeft<=30);

 $('glass').classList.toggle('active',active);
 $('transfer').textContent=Math.floor(answer);
 $('fakeAnswer').textContent='ANSWER: '+['A','C','B','D','A','B'][question%6];

 $('warning').textContent=
  suspicion>=85?'🚨 EMP 발사 직전! 안경을 꺼라!':
  suspicion>=70?'⚠ 감독관이 당신을 조준했다!':
  suspicion>=50?'⚠ EMP 광선총 충전 중':
  suspicion>=30?'감독관이 당신을 쳐다보고 있다.':'';

 $('toggle').textContent=active?'■ 안경 작동 중지':'◉ AI 안경 작동';
 $('toggle').classList.toggle('on',active);
}

function endGame(win,reason){
 playing=false;ended=true;active=false;
 $('glass').classList.remove('active');
 $('toggle').disabled=true;

 if(!win&&reason==='emp'){
  fired=true;explosion=1.1;
  $('warning').textContent='EMP DISCHARGED!';
  $('warning').classList.add('danger');
  $('message').classList.add('hidden');
  setTimeout(()=>showResult(false,reason),1000);
 }else{
  showResult(win,reason);
 }
}

function showResult(win,reason){
 $('message').classList.remove('hidden');
 let title=win?'🏆 시험 완료':reason==='time'?'⌛ 시간 초과':'💥 안경 파괴!';
 let desc=win?
  '45문제를 모두 해결했다. 무사히 시험을 마쳤다.':
  reason==='time'?
  '제한 시간 3분이 끝났다. 해결한 문제: '+question+'/45':
  '감독관의 EMP 광선에 안경이 파괴되었다.<br>해결한 문제: '+question+'/45';

 $('message').innerHTML=`
 <h1>${title}</h1>
 <p>${desc}</p>
 <button id="restart">다시 시작</button>`;
 $('restart').addEventListener('click',start);
}

function update(dt){
 if(!playing)return;

 timeLeft-=dt;
 if(timeLeft<=0){
  timeLeft=0;
  updateHUD();
  endGame(false,'time');
  return;
 }

 // Fixed examiner: only gaze changes
 looking=suspicion>=30;

 // EMP charging follows suspicion
 if(suspicion>=50){
  empCharge=Math.min(100,empCharge+dt*(5.5+(suspicion-50)*.10));
 }else{
  empCharge=Math.max(0,empCharge-dt*3);
 }

 if(active){
  answer+=dt*(15-question*.045);
  suspicion+=dt*(8.2+question*.14);
 }else{
  suspicion-=dt*7;
 }

 answer=Math.max(0,Math.min(100,answer));
 suspicion=Math.max(0,Math.min(100,suspicion));

 if(answer>=100){
  question++;
  answer=0;
  if(question>=45){
   endGame(true,'win');
   return;
  }
 }

 // EMP fires when charge completes
 if(empCharge>=100){
  empCharge=100;
  endGame(false,'emp');
  return;
 }

 updateHUD();
}

function loop(now){
 const dt=Math.min((now-last)/1000,.05)||0;
 last=now;
 if(fired&&explosion>0){
  explosion=Math.max(0,explosion-dt);
 }
 update(dt);
 draw();
 requestAnimationFrame(loop);
}

function start(){
 question=0;answer=0;suspicion=0;
 timeLeft=180;empCharge=0;
 active=false;looking=false;
 ended=false;playing=true;
 fired=false;explosion=0;

 $('message').classList.add('hidden');
 $('warning').classList.remove('danger');
 $('toggle').disabled=false;
 updateHUD();
}

function toggle(){
 if(!playing||ended)return;
 active=!active;
 updateHUD();
}

$('start').addEventListener('click',start);
$('toggle').addEventListener('click',toggle);

window.addEventListener('keydown',e=>{
 if(e.code==='Space'&&playing){
  e.preventDefault();
  if(!e.repeat)toggle();
 }
});

document.addEventListener('visibilitychange',()=>{
 last=performance.now();
});

last=performance.now();
loop(last);
})();
</script>
</body>
</html>
